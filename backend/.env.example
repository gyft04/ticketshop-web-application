# Vorlage fuer backend/.env
#
# Kopiere diese Datei nach backend/.env und trage deine eigenen
# Werte ein. Die .env selbst steht in der .gitignore und wird
# nie committet - jeder im Team hat seine eigene.

# --- Datenbank -------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ticketshop

# --- Auth ------------------------------------------------------
# Entwicklungswert - muss bei allen im Team identisch sein, sonst
# sind die ausgestellten JWTs untereinander ungueltig.
JWT_SECRET=ticketshop_super_secret_key_2026